{
  "name": "laserreach-intelli",
  "version": "1.0.0",
  "description": "Laserreach Intelli in-call revenue intelligence desktop app",
  "author": "Laserreach",
  "main": "main.js",
  "scripts": {
    "start": "npx electron . --user-data-dir=./.temp-user-data",
    "test-icon": "node test-app-icon.js",
    "build-asr": "python3 build-asr-binary.py",
    "build": "./build-optimized.sh",
    "build-mas": "./build-mas.sh",
    "build-dmg": "./build-optimized.sh",
    "build-mac": "electron-builder --mac",
    "build-electron-only": "electron-builder",
    "dist": "electron-builder --publish=never",
    "test-audio": "node test-audio-performance.js",
    "build-check": "electron-builder --dir --publish=never",
    "build-check-mac": "electron-builder --dir --mac --arm64 --publish=never",
    "build-check-linux": "electron-builder --dir --linux --x64 --publish=never",
    "build-check-win": "electron-builder --dir --win --x64 --publish=never",
    "build-check-all": "npm run build-check-mac && npm run build-check-linux && npm run build-check-win"
  },
  "build": {
    "appId": "com.laserreach.intelli",
    "productName": "Laserreach Intelli",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*"
    ],
    "mac": {
      "icon": "app-icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@xenova/transformers": "^2.17.2",
    "express": "^5.1.0",
    "jsdom": "^26.1.0",
    "node-llama-cpp": "^3.10.0",
    "nodejs-whisper": "^0.2.9",
    "recordrtc": "^5.6.2"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.13.3"
  }
}
